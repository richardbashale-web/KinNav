{
  "$jsonSchema": {
    "bsonType": "object",
    "required": ["location", "type", "severity", "status", "created_at"],
    "properties": {
      "user_id": { "bsonType": ["string", "null"] },
      "location": {
        "bsonType": "object",
        "required": ["type", "coordinates"],
        "properties": {
          "type": { "enum": ["Point"] },
          "coordinates": {
            "bsonType": "array",
            "items": { "bsonType": "double" },
            "minItems": 2,
            "maxItems": 2
          }
        }
      },
      "type": { "enum": ["accident", "works", "jam", "barrier", "flood", "clear"] },
      "severity": { "enum": ["low", "medium", "high", "critical"] },
      "description": { "bsonType": ["string", "null"], "maxLength": 500 },
      "votes_confirm": { "bsonType": "int", "minimum": 0 },
      "votes_deny": { "bsonType": "int", "minimum": 0 },
      "status": { "enum": ["active", "resolved", "false_positive"] },
      "created_at": { "bsonType": "date" },
      "resolved_at": { "bsonType": ["date", "null"] }
    }
  }
}
